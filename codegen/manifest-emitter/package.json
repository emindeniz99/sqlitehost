{
  "name": "@sqlite-host/emitter-manifest",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "SqliteHost manifest emitter: canonical manifest JSON + DDL snapshot from a TypeSpec host library",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "sqlite-host-emit-manifest": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test 'dist/test/*.test.js'"
  },
  "dependencies": {
    "@sqlite-host/codegen-core": "workspace:*",
    "@sqlite-host/typespec": "workspace:*",
    "@typespec/compiler": "1.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
