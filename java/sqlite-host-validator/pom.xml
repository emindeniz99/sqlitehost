<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.emindeniz99</groupId>
    <artifactId>sqlite-host-parent</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>sqlite-host-validator</artifactId>

  <name>SqliteHost Validator</name>
  <description>
    Script semantic lint over (manifest, parsed script): structural,
    binding, host-call usage, and result-read lineage rules with a
    hand-written SQL tokenizer. Library-first; includes a thin CLI.
  </description>

  <dependencies>
    <dependency>
      <groupId>io.github.emindeniz99</groupId>
      <artifactId>sqlite-host-model</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Distributable CLI: shade an executable fat jar
           (…-cli.jar) next to the plain library jar. Run it with
           `java -jar` (see java/README.md). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>cli</shadedClassifierName>
              <!-- The library jar stays the module's main artifact; the
                   fat jar only rides along under the `cli` classifier, so
                   there is no reduced dependency set to write out. -->
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.sqlitehost.validator.cli.ValidatorCli</mainClass>
                </transformer>
                <!-- The `cli` classifier is deployed to Maven Central, so
                     the jar has to carry the attribution of what it
                     bundles. Jackson (databind, core, annotations) is
                     Apache-2.0 and each of its jars ships its own
                     META-INF/NOTICE; without this transformer the three
                     collide and one arbitrary NOTICE survives, which is
                     what Apache-2.0 §4(d) forbids. addHeader=false because
                     the header this transformer writes by default credits
                     the Apache Software Foundation, which does not own
                     this project. META-INF/LICENSE needs no merging: every
                     bundled dependency is Apache-2.0, so the surviving
                     copy is the same licence text. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer">
                  <addHeader>false</addHeader>
                </transformer>
                <!-- This project's own MIT terms, under a name that does
                     not collide with the bundled Apache-2.0 LICENSE. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                  <resource>META-INF/LICENSE-sqlite-host.txt</resource>
                  <file>${project.basedir}/../../LICENSE</file>
                </transformer>
              </transformers>
              <filters>
                <!-- Drop per-dependency module descriptors: the fat jar
                     is classpath-only and shading them just warns. -->
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
