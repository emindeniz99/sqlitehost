<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.emindeniz99</groupId>
    <artifactId>sqlite-host-parent</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>sqlite-host-validator</artifactId>

  <name>SqliteHost Validator</name>
  <description>
    Script semantic lint over (manifest, parsed script): structural,
    binding, host-call usage, and result-read lineage rules with a
    hand-written SQL tokenizer. Library-first; includes a thin CLI.
  </description>

  <dependencies>
    <dependency>
      <groupId>io.github.emindeniz99</groupId>
      <artifactId>sqlite-host-model</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Distributable CLI: shade an executable fat jar
           (…-cli.jar) next to the plain library jar. Launched by
           java/bin/sqlite-host-validate (see java/README.md). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>cli</shadedClassifierName>
              <!-- The shaded jar is a local tool, not a published
                   artifact — don't write dependency-reduced-pom.xml
                   into the module directory. -->
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.sqlitehost.validator.cli.ValidatorCli</mainClass>
                </transformer>
              </transformers>
              <filters>
                <!-- Drop per-dependency module descriptors: the fat jar
                     is classpath-only and shading them just warns. -->
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
