<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.emindeniz99</groupId>
  <artifactId>sqlite-host-parent</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>

  <name>SqliteHost Java</name>
  <description>
    Java model, semantic validator, and prepare-only JDBC validator for
    SqliteHost script payloads (plan phase 4). See the docs/ folder.
  </description>

  <!-- Maven Central publishing metadata — inherited by all modules.
       See docs/guides/publishing.md section e. -->
  <url>https://github.com/emindeniz99/sqlitehost</url>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>emindeniz99</id>
      <name>Emin Deniz</name>
      <email>emindeniz99@gmail.com</email>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/emindeniz99/sqlitehost.git</connection>
    <developerConnection>scm:git:git@github.com:emindeniz99/sqlitehost.git</developerConnection>
    <url>https://github.com/emindeniz99/sqlitehost/tree/main/java</url>
  </scm>

  <modules>
    <module>sqlite-host-model</module>
    <module>sqlite-host-validator</module>
    <module>sqlite-host-jdbc</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <jackson.version>2.18.9</jackson.version>
    <junit.version>5.10.2</junit.version>
    <sqlite-jdbc.version>3.45.3.0</sqlite-jdbc.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>org.xerial</groupId>
        <artifactId>sqlite-jdbc</artifactId>
        <version>${sqlite-jdbc.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!-- Everything Maven Central demands beyond a plain build: sources jar,
         javadoc jar, GPG signatures, and the Central Portal uploader.
         Activated only at release (mvn -B -P central deploy, which is what
         .github/workflows/release.yml runs) so day-to-day `mvn test` stays
         fast and needs no GPG key.

         Credentials in CI: actions/setup-java writes the settings.xml
         server entry whose id matches publishingServerId below and imports
         the GPG key; locally, the Portal token lives in ~/.m2/settings.xml
         under server id `central` and the passphrase comes from gpg-agent.

         autoPublish=true: a validated bundle goes live without a manual
         Publish click, which is what makes a tag-driven release hands-free.
         Flip to false for the very first release if you want to inspect the
         bundle at https://central.sonatype.com/publishing before it ships. -->
    <profile>
      <id>central</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.4.0</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.12.0</version>
            <configuration>
              <doclint>none</doclint>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
