{
  "name": "@sqlite-host/authoring",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "SqliteHost TypeScript authoring SDK: generated typed method surface, manifest metadata/autocomplete, fluent script builder, and static payload lint",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emindeniz99/sqlitehost.git",
    "directory": "typescript/authoring-sdk"
  },
  "keywords": [
    "sqlitehost",
    "sqlite",
    "authoring",
    "script-builder",
    "lint",
    "typescript"
  ],
  "author": "Emin Deniz",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./delivery": "./dist/delivery.js"
  },
  "files": [
    "dist",
    "!dist/test",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@sqlite-host/codegen-core": "workspace:*",
    "@sqlite-host/runtime-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
