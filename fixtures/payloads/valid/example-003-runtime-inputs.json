{
  "engine": "sqlite-host-v1",
  "scriptId": "example-003",
  "requiredApiLevel": 1,
  "requiredFeatures": [
    "typedNamedBindings",
    "splitResultTables",
    "scriptInputs"
  ],
  "requiredMethods": [
    "getValue",
    "setValue"
  ],
  "inputs": [
    {
      "name": "targetValue",
      "value": {
        "type": "int64",
        "value": 42
      }
    }
  ],
  "steps": [
    {
      "id": "write-from-input",
      "statements": [
        {
          "sql": "INSERT INTO call_set_value (call_id, input_key, input_value) SELECT :callId, 'example-key', int_value FROM script_inputs WHERE name = 'targetValue'",
          "bindings": {
            "callId": {
              "type": "text",
              "value": "write-1"
            }
          }
        }
      ]
    },
    {
      "id": "confirm",
      "statements": [
        {
          "sql": "INSERT INTO call_get_value (call_id, input_key) SELECT :callId, 'example-key' WHERE EXISTS (SELECT 1 FROM result_set_value WHERE call_id = :writeCallId AND status = 'done' AND result_success = 1)",
          "bindings": {
            "callId": {
              "type": "text",
              "value": "confirm-1"
            },
            "writeCallId": {
              "type": "text",
              "value": "write-1"
            }
          }
        }
      ]
    }
  ]
}
