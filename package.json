{
  "name": "@sqlite-host/workspace",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "Workspace root for the SqliteHost npm packages (TypeSpec library, emitters, TypeScript SDKs)",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test"
  },
  "devDependencies": {
    "@sqlite-host/typespec": "workspace:*"
  },
  "pnpm": {
    "overrides": {
      "tar": ">=7.5.21",
      "fast-uri": ">=3.1.6 <4"
    }
  }
}
