<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>SqliteHost.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <!-- Dynamic native override: SQLITEHOST_NATIVE_SQLITE=<path.so> loads an
         arbitrary sqlite3 build instead of the bundled e_sqlite3 (see
         Adapter/NativeSqliteOverride.cs and tests/compatibility-sqlite/). -->
    <PackageReference Include="SQLitePCLRaw.provider.dynamic_cdecl" Version="2.1.13" />
    <!-- Pin the whole SQLitePCLRaw graph to one version: sqlite-net-pcl
         pulls core 2.1.8, so the 2.1.6 bundle Microsoft.Data.Sqlite asks
         for would otherwise mix a 2.1.6 provider with a 2.1.8 core. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <!-- Additional adapters for the multi-adapter integration matrix. -->
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
    <PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SqliteHost.Abstractions/SqliteHost.Abstractions.csproj" />
    <ProjectReference Include="../SqliteHost.Runtime/SqliteHost.Runtime.csproj" />
    <ProjectReference Include="../SqliteHost.Conformance/SqliteHost.Conformance.csproj" />
    <ProjectReference Include="../SqliteHost.Delivery/SqliteHost.Delivery.csproj" />
    <ProjectReference Include="../SqliteHost.Adapters.Native/SqliteHost.Adapters.Native.csproj" />
    <ProjectReference Include="../SqliteHost.Generated.Sample/SqliteHost.Generated.Sample.csproj" />
    <ProjectReference Include="../SqliteHost.Generated.Sample.Compact/SqliteHost.Generated.Sample.Compact.csproj" />
    <ProjectReference Include="../SqliteHost.Generated.Sample.Ultra/SqliteHost.Generated.Sample.Ultra.csproj" />
  </ItemGroup>

</Project>
