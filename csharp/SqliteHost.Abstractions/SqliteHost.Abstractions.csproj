<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <RootNamespace>SqliteHost</RootNamespace>
    <AssemblyName>SqliteHost.Abstractions</AssemblyName>
    <Description>SqliteHost adapter interfaces, script envelope DTOs, and result types (Unity-2021-safe, zero dependencies).</Description>
  </PropertyGroup>

  <PropertyGroup Label="NuGet pack metadata">
    <PackageId>SqliteHost.Abstractions</PackageId>
    <Version>0.2.0</Version>
    <Authors>Emin Deniz</Authors>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <RepositoryUrl>https://github.com/emindeniz99/sqlitehost</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SqliteHost.Runtime"/>
    <InternalsVisibleTo Include="SqliteHost.Tests"/>
  </ItemGroup>

</Project>
