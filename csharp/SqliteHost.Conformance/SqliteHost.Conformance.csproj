<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <RootNamespace>SqliteHost.Conformance</RootNamespace>
    <AssemblyName>SqliteHost.Conformance</AssemblyName>
    <!-- Class library that SHIPS tests; it is not itself runnable — the
         consumer's test project (with a runner + concrete subclasses) is.
         Without this, solution-level `dotnet test` tries to execute it. -->
    <IsTestProject>false</IsTestProject>
    <Description>Reusable adapter conformance test suite for SqliteHost (docs/adapter-contract.md): consumers subclass AdapterConformanceTestsBase in their xunit test project with a factory for their ISqliteHostConnection adapter, and the suite proves error surfacing, binding resolution, and value fidelity (Unity-2021-safe).</Description>
  </PropertyGroup>

  <PropertyGroup Label="NuGet pack metadata">
    <PackageId>SqliteHost.Conformance</PackageId>
    <Version>0.1.0</Version>
    <Authors>Emin Deniz</Authors>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <RepositoryUrl>https://github.com/emindeniz99/sqlitehost</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <!-- Minimal xunit surface that supports netstandard2.0: the attributes
         ([SkippableFact] via Xunit.SkippableFact) and assertions only; the
         consumer's test project brings the runner. -->
    <PackageReference Include="xunit.core" Version="2.9.3" />
    <PackageReference Include="xunit.assert" Version="2.9.3" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SqliteHost.Abstractions/SqliteHost.Abstractions.csproj" />
    <ProjectReference Include="../SqliteHost.Runtime/SqliteHost.Runtime.csproj" />
  </ItemGroup>

</Project>
