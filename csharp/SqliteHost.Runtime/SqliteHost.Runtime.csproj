<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <RootNamespace>SqliteHost</RootNamespace>
    <AssemblyName>SqliteHost.Runtime</AssemblyName>
    <Description>SqliteHost execution core: host definition, fluent method descriptors, schema generation, script execution, and queue draining (Unity-2021-safe).</Description>
  </PropertyGroup>

  <!-- Size-critical vendoring builds: -p:SqliteHostSlim=true (or the
       SQLITEHOST_SLIM define symbol in Unity) strips the optional strict
       checks — registration-time naming/shape validation, lexical binding
       validation, ultra result-shape enforcement, list-child-after-drain
       probing. See docs/compatibility.md (App size). -->
  <PropertyGroup Condition="'$(SqliteHostSlim)' == 'true'">
    <DefineConstants>$(DefineConstants);SQLITEHOST_SLIM</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Label="NuGet pack metadata">
    <PackageId>SqliteHost.Runtime</PackageId>
    <Version>0.1.0</Version>
    <Authors>Emin Deniz</Authors>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <RepositoryUrl>https://github.com/emindeniz99/sqlitehost</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SqliteHost.Abstractions/SqliteHost.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SqliteHost.Tests" />
  </ItemGroup>

</Project>
