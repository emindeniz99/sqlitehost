    <!-- TODO: set the real repository URL before publishing.
         <RepositoryUrl>https://github.com/OWNER/REPO</RepositoryUrl> -->
    <!-- TODO: license undecided — pick one and uncomment before publishing;
         see docs/guides/publishing.md.
