<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <RootNamespace>SqliteHost.Delivery</RootNamespace>
    <AssemblyName>SqliteHost.Delivery</AssemblyName>
    <Description>Optional SqliteHost script-delivery trust layer: verifies signed script envelopes (rsa-sha256 / hmac-sha256) and returns the payload bytes. No transport, no storage, no clock, no dependency on SqliteHost.Runtime (Unity-2021-safe, zero external dependencies).</Description>
  </PropertyGroup>

  <!-- Deliberately references neither SqliteHost.Runtime nor
       SqliteHost.Abstractions: delivery moves opaque bytes and knows
       nothing about hosts, methods or SQL, and the runtime packages'
       measured footprint (docs/reports/il2cpp-size-report.md) must not
       grow a crypto dependency every non-delivery consumer would link.
       See docs/proposals/script-delivery.md (Package placement). -->

  <PropertyGroup Label="NuGet pack metadata">
    <PackageId>SqliteHost.Delivery</PackageId>
    <Version>0.1.0</Version>
    <Authors>Emin Deniz</Authors>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <RepositoryUrl>https://github.com/emindeniz99/sqlitehost</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SqliteHost.Tests" />
  </ItemGroup>

</Project>
