<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <RootNamespace>SqliteHost.Adapters.Native</RootNamespace>
    <AssemblyName>SqliteHost.Adapters.Native</AssemblyName>
    <Description>SqliteHost adapter over a platform-provided libsqlite3 via direct P/Invoke (DllImport("sqlite3")) — no wrapper dependency, the pattern Unity SQLite wrappers use. Implements the full adapter contract including the optional inline scalar-function capability (Unity-2021-safe; see the IL2CPP note on NativeSqliteHostConnection).</Description>
  </PropertyGroup>

  <PropertyGroup Label="NuGet pack metadata">
    <PackageId>SqliteHost.Adapters.Native</PackageId>
    <Version>0.1.0-preview</Version>
    <Authors>Emin Deniz</Authors>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <RepositoryUrl>https://github.com/emindeniz99/sqlitehost</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SqliteHost.Abstractions/SqliteHost.Abstractions.csproj" />
  </ItemGroup>

</Project>
