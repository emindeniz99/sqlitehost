{
  "name": "@sqlite-host/typespec",
  "version": "0.1.0",
  "private": true,
  "description": "TypeSpec library for SqliteHost: script envelope models, host-method decorators, and model validation diagnostics",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "tspMain": "lib/main.tsp",
  "exports": {
    ".": {
      "typespec": "./lib/main.tsp",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "lib"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test 'dist/test/*.test.js'"
  },
  "peerDependencies": {
    "@typespec/compiler": "1.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typespec/compiler": "1.13.0",
    "typescript": "^5.5.0"
  }
}
