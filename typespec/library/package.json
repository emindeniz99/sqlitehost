{
  "name": "@sqlite-host/typespec",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "TypeSpec library for SqliteHost: script envelope models, host-method decorators, and model validation diagnostics",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emindeniz99/sqlitehost.git",
    "directory": "typespec/library"
  },
  "keywords": [
    "sqlitehost",
    "typespec",
    "sqlite",
    "codegen",
    "script-envelope",
    "host-functions"
  ],
  "author": "Emin Deniz",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "tspMain": "lib/main.tsp",
  "exports": {
    ".": {
      "typespec": "./lib/main.tsp",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/test",
    "lib",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "peerDependencies": {
    "@typespec/compiler": "1.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typespec/compiler": "1.15.0",
    "typescript": "^5.5.0"
  }
}
